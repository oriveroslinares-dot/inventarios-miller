# Copie este archivo como .env y complete los valores reales.
# NUNCA suba el archivo .env (con credenciales reales) al repositorio.

APP_NAME=TRIPLE AAA DE CARTAGENITA
ENVIRONMENT=development
SECRET_KEY=cambie-esta-clave-por-una-aleatoria-y-segura
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Base de datos (SQLite por defecto; use PostgreSQL en producción)
DATABASE_URL=sqlite:///./triple_aaa.db

# Evidencias (fotografías / documentos)
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=15

# --- WhatsApp Business Platform / Meta Cloud API ---
# Complete estos valores solo cuando Meta apruebe la cuenta y se generen las credenciales.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# --- SINFA (sistema financiero / facturación) ---
SINFA_API_URL=
SINFA_API_KEY=
SINFA_SYNC_MODE=NONE

# --- GBS (inventario / compras) ---
GBS_API_URL=
GBS_API_KEY=
GBS_SYNC_MODE=NONE

# Datos de prueba (desactivar en producción)
LOAD_DEMO_DATA=true
